# Berth application environment (spec §9.1)
# Copy to .env for local development outside Docker.

# Database
DATABASE_URL=postgresql://berth:berth@postgres:5432/berth

# Registry (internal)
REGISTRY_INTERNAL_URL=http://registry:5000
# Upstream timeout for /v2/* proxy uploads (default 600000 ms)
# REGISTRY_PROXY_TIMEOUT_MS=600000

# Token issuer (Phase 3+)
TOKEN_ISSUER=registry
TOKEN_TTL_SECONDS=300
# Inline PEM (production) or file paths (compose dev mounts):
# TOKEN_SIGNING_KEY=
TOKEN_SIGNING_KEY_PATH=docker/token/dev-signing-key.pem
# TOKEN_CERT=
TOKEN_CERT_PATH=docker/registry/certs/rootcert.pem
REGISTRY_AUTH_TOKEN_SERVICE=registry

# Session
SESSION_SECRET=change-me-in-production

# OIDC (optional — single provider in MVP)
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# Bootstrap admin (Phase 1+)
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=

# App
APP_URL=http://localhost:8080

# Portal defaults
TAGLIST_PAGE_SIZE=100
THEME_DEFAULT=system

# User lifecycle (soft delete grace period in days; 0 = immediate hard delete)
# USER_DELETE_GRACE_PERIOD_DAYS=30

# Token & session TTL
TOKEN_TTL_SECONDS=300
SESSION_TTL_SECONDS=604800

# Rate limiting
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10
# Higher dev default for docker push/pull integration (compose sets 200)
# RATE_LIMIT_TOKEN_MAX_ATTEMPTS=200
RATE_LIMIT_WINDOW_SECONDS=60

# SMTP email (optional — required for password reset and invite emails)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# EMAIL_FROM=noreply@example.com
# EMAIL_FROM_NAME=Berth
# PASSWORD_RESET_TTL_HOURS=1
# USER_INVITE_TTL_HOURS=72
